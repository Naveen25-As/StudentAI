# Backend configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=studentai_db
APP_ENV=development

# Local in-memory demo student provisioning. Disabled unless explicitly enabled
# and a non-empty operator-supplied password is provided. Never set in production.
DEMO_STUDENT_ENABLED=false
DEMO_STUDENT_PASSWORD=
DEMO_STUDENT_EMAIL=student@example.test

# Authentication secret for backend JWT signing. Generate a unique secret for
# each environment; do not expose this value to the frontend or commit real secrets.
JWT_SECRET=

# Public frontend setting; Vite exposes VITE_* values in browser assets.
VITE_API_URL=http://localhost:8000/api/v1
